# Copy to a private .env. Never publish real credentials.
MEMORY_API_KEY=
AE_EMBEDDING_BACKEND=dashscope
DASHSCOPE_API_KEY=
# Replace WorkspaceId and region with the native HTTP endpoint in your console.
AE_EMBEDDING_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
AE_EMBEDDING_DIMENSIONS=1024
AE_EMBEDDING_BATCH_SIZE=10
AE_EMBEDDING_TIMEOUT=60
AE_EMBEDDING_MAX_ATTEMPTS=3
# Per-process request guard INCLUDING retries; 0 means no local limit.
# Restarts reset this guard. Configure account limits with the provider.
AE_EMBEDDING_MAX_REQUESTS=0
AE_DATABASE=/data/context-weave-v031/memory.sqlite3
AE_CONTEXT_CHARS=24000
AE_MODE=hybrid_window
# GPT-4o-mini is used during Add through OpenRouter. Use a fresh database.
AE_ADD_INDEXER=1
OPENROUTER_API_KEY=
AE_ADD_LLM_TIMEOUT=60
AE_ADD_LLM_MAX_ATTEMPTS=3
AE_ADD_LLM_CONCURRENCY=4
# Per-process request guard including retries; 0 means no local limit.
AE_ADD_LLM_MAX_REQUESTS=0
# Optional Search planner remains disabled; Add still calls GPT-4o-mini.
AE_PLANNER=0
OPENAI_API_KEY=
AE_PLANNER_MAX_CALLS=2000
# Optional public Caddy profile. Use a domain pointing at your server.
AE_DOMAIN=localhost
